{
  "$schema": "https://opencode.ai/config.json",
  "command": {
    "sdd-new": {
      "template": "Run the full 8-phase SDD pipeline for the given change. Use the SDD skills under .opencode/skills/ and delegate to sdd subagents via the task tool for phases 1-5, then implement for phase 6, verify with sdd-verifier for phase 7, and archive with sdd-archiver for phase 8. Run sequentially: explore -> propose -> spec -> design -> tasks -> apply -> verify -> archive. Change: $ARGUMENTS",
      "description": "Run full Spec-Driven Development pipeline"
    }
  },
  "default_agent": "n3rv",
  "instructions": [
    "AGENTS.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs/*.md"
  ],
  "tools": {
    "websearch": true
  },
  "agent": {
    "build": { "disable": true },
    "plan": { "disable": true }
  },
  "mcp": {
{% for srv in profile_mcp_servers %}{% if not loop.first %},{% endif %}
    "{{ srv.name }}": {
      "type": "{{ srv.type }}"{% if srv.command %},
      "command": {{ srv.command | tojson }}{% endif %}{% if srv.url %},
      "url": "{{ srv.url }}"{% endif %}{% if srv.environment %},
      "environment": {{ srv.environment | tojson }}{% endif %}{% if srv.disabled %},
      "enabled": false{% endif %}
    }{% endfor %}
  }
}
